# Release imzo kaliti (NAMUNA — nusxalab to'ldiring, git'ga tushmaydi).
# 1) Nusxa:  copy keystore.properties.example keystore.properties   (Windows)
#            cp keystore.properties.example keystore.properties     (macOS/Linux)
# 2) Kalit yarating (bir marta):
#    keytool -genkeypair -v -keystore ..\kradus-release.jks -alias kradus -keyalg RSA -keysize 2048 -validity 10000
# 3) Shu faylni to'ldiring:
storeFile=../kradus-release.jks
storePassword=SIRNI_YOZING
keyAlias=kradus
keyPassword=SIRNI_YOZING
