<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Kradus Media requests the minimum possible permissions (port of
      app.config.ts blockedPermissions):
      - NO READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE / MANAGE_EXTERNAL_STORAGE
      - NO READ_MEDIA_AUDIO / IMAGES / VIDEO
      - NO RECORD_AUDIO, NO CAMERA, NO LOCATION
      Files come only from the system document picker (user-chosen MP3s).
      POST_NOTIFICATIONS is declared but requested at runtime ONLY after the
      user starts playback (media notification / lock-screen controls).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Streaming of user-added URL tracks (no downloads, no tracking). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Shared music library scan (user-initiated only, from the Library screen).
      Android 13+ uses READ_MEDIA_AUDIO; older versions use READ_EXTERNAL_STORAGE.
      The system document picker path still works WITHOUT these permissions.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Optional full file access (user-initiated only, from the Library screen).
      Lets the native scanner find non-indexed MP3s on internal + SD storage.
      Never requested silently; the app works fully without it.
      Distribution note: this build is shared directly (APK). A Google Play
      release would need the All-Files-Access declaration form approved, or
      this permission dropped (MediaStore scan alone still works).
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:name=".KradusApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@drawable/kradus_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KradusMedia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".music.KradusPlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

    </application>
</manifest>
